# Скопируй в .env: cp .env.example .env

# Порт API внутри контейнера / при локальном запуске
PORT=3001

# Секрет для подписи JWT. Если оставить пустым, сервер сгенерирует его при первом запуске
# и сохранит в папке данных (она не попадает в репозиторий).
JWT_SECRET=

# Контактный адрес для Web Push (формат mailto:... или https://...)
VAPID_SUBJECT=mailto:admin@example.com

# true — при старте создать демо-пользователя demo@test.ru с историей отметок
SEED_DEMO=true
